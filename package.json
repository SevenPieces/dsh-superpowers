{
  "name": "dsh-superpowers",
  "version": "0.1.0",
  "description": "Superpowers skills port for DSH: plugin-registered skill provider + assembly-time system-prompt bootstrap section",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
